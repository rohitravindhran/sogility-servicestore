{
  "expo": {
    "name": "Sogility",
    "slug": "sogility-servicestore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sogility-logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "deepLinking": {
      "scheme": "myapp",
      "autoVerify": true
    },
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/sogility-logo.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.developersomnify.sogilityservicestore",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/sogility-logo.png",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/sogility-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.developersomnify.sogilityservicestore"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sogility-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/sogility-logo.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9626591b-39f0-49a4-a0e0-95caca65b418"
      }
    }
  }
}
